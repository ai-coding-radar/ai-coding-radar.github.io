{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Radar explicit income ledger",
  "type": "object",
  "required": ["schema_version", "currency", "settled_revenue", "cost", "pending_revenue", "estimated_revenue", "entries"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 2 },
    "currency": { "type": "string", "minLength": 1, "maxLength": 12 },
    "settled_revenue": { "type": "number", "minimum": 0 },
    "cost": { "type": "number", "minimum": 0 },
    "pending_revenue": { "type": "number", "minimum": 0 },
    "estimated_revenue": { "type": "number", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "amount", "status"],
        "additionalProperties": true,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "kind": { "enum": ["settled_revenue", "revenue", "pending_revenue", "estimated_revenue", "cost"] },
          "amount": { "type": "number", "minimum": 0 },
          "status": { "type": "string" },
          "note": { "type": "string" },
          "receipt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
